<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="48dp">

    <!-- ============ TOP LEFT: disclaimer ============ -->
    <LinearLayout
        android:id="@+id/disclaimerBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aster_surface"
        android:padding="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/formBox"
        app:layout_constraintHorizontal_chainStyle="spread"
        android:layout_marginEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/aster_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/pairing_tagline"
            android:textColor="@color/aster_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pairing_disclaimer"
            android:textColor="@color/aster_text_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <!-- ============ TOP RIGHT: code / user / password form ============ -->
    <LinearLayout
        android:id="@+id/formBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aster_surface"
        android:padding="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/disclaimerBox"
        app:layout_constraintWidth_percent="0.42">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pairing_form_title"
            android:textColor="@color/aster_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/pairing_form_subtitle"
            android:textColor="@color/aster_text_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/codeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/pairing_hint_code"
            android:textColorHint="@color/aster_text_muted"
            android:textColor="@color/aster_text"
            android:textSize="18sp"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:padding="12dp"
            android:background="@color/aster_bg" />

        <EditText
            android:id="@+id/userInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/pairing_hint_user"
            android:textColorHint="@color/aster_text_muted"
            android:textColor="@color/aster_text"
            android:textSize="18sp"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:padding="12dp"
            android:background="@color/aster_bg" />

        <EditText
            android:id="@+id/passInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/pairing_hint_pass"
            android:textColorHint="@color/aster_text_muted"
            android:textColor="@color/aster_text"
            android:textSize="18sp"
            android:inputType="textPassword"
            android:imeOptions="actionDone"
            android:padding="12dp"
            android:background="@color/aster_bg" />

        <Button
            android:id="@+id/loginBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pairing_login_button"
            android:textColor="@color/aster_on_primary"
            android:textStyle="bold"
            android:backgroundTint="@color/aster_primary" />
    </LinearLayout>

    <!-- ============ CENTER: status message ============ -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/pairing_waiting"
        android:textColor="@color/aster_text_muted"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/formBox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ BOTTOM LEFT: MAC ============ -->
    <LinearLayout
        android:id="@+id/macBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aster_surface"
        android:padding="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/keyBox"
        android:layout_marginEnd="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pairing_mac_label"
            android:textColor="@color/aster_text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/macText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/aster_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="AE:10:12:34:56:78" />
    </LinearLayout>

    <!-- ============ BOTTOM RIGHT: KEY ============ -->
    <LinearLayout
        android:id="@+id/keyBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aster_surface"
        android:padding="24dp"
        android:gravity="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/macBox"
        app:layout_constraintWidth_percent="0.42">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pairing_key_label"
            android:textColor="@color/aster_text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/keyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/aster_text"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="482913" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
