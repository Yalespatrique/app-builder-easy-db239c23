<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="40dp">

    <!-- Logo tamanho ícone (figurinha) -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="Asterplay"
        android:src="@drawable/logo_asterplay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/txtDisclaimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Asterplay é apenas um reprodutor de mídia. O usuário é responsável pelo conteúdo carregado."
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toTopOf="@id/imgLogo"
        app:layout_constraintBottom_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toEndOf="@id/imgLogo"
        app:layout_constraintEnd_toStartOf="@id/loginBox"/>

    <!-- Login por Código/Usuário/Senha -->
    <LinearLayout
        android:id="@+id/loginBox"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC101019"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Entrar com código" android:textColor="#FFD700" android:textSize="22sp" android:textStyle="bold"/>
        <EditText android:id="@+id/edtDns" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Código" android:textColorHint="#888" android:textColor="#FFF" android:textSize="18sp" android:layout_marginTop="14dp"/>
        <EditText android:id="@+id/edtUser" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Usuário" android:textColorHint="#888" android:textColor="#FFF" android:textSize="18sp"/>
        <EditText android:id="@+id/edtPass" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Senha" android:inputType="textPassword" android:textColorHint="#888" android:textColor="#FFF" android:textSize="18sp"/>
        <Button android:id="@+id/btnLoginCode" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ENTRAR" android:textSize="18sp" android:layout_marginTop="16dp"/>
    </LinearLayout>

    <!-- MAC (inferior esquerdo) -->
    <LinearLayout
        android:id="@+id/macBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/txtVersion"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MAC" android:textColor="#AAA" android:textSize="18sp"/>
        <TextView android:id="@+id/txtMac" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFD700" android:textSize="36sp" android:textStyle="bold"/>
        <Button android:id="@+id/btnCheckMac" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Verificar ativação" android:textSize="16sp" android:layout_marginTop="10dp"/>
    </LinearLayout>

    <!-- Painel + Key (centro inferior) -->
    <LinearLayout
        android:id="@+id/panelBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/txtVersion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Painel" android:textColor="#AAA" android:textSize="18sp"/>
        <TextView android:id="@+id/txtPanel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="appasterplay.top" android:textColor="#00E676" android:textSize="30sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Chave" android:textColor="#AAA" android:textSize="18sp" android:layout_marginTop="10dp"/>
        <TextView android:id="@+id/txtKey" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFD700" android:textSize="34sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Versão (rodapé) -->
    <TextView
        android:id="@+id/txtVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#888"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
