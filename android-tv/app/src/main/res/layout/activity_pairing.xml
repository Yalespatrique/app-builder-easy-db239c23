<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Overlay escuro para dar contraste ao texto -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- ===== Topo: logo + disclaimer ===== -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Asterplay"
            android:src="@drawable/logo_asterplay"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASTERPLAY"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.25"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="@id/imgLogo"
            app:layout_constraintBottom_toBottomOf="@id/imgLogo"
            app:layout_constraintStart_toEndOf="@id/imgLogo"/>

        <TextView
            android:id="@+id/txtDisclaimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Reprodutor de mídia. O usuário é responsável pelo conteúdo carregado."
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/imgLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/loginCard"
            android:layout_marginEnd="32dp"/>

        <!-- ===== Card de Login ===== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/loginCard"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#F20A0F1A"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entrar"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informe os dados do seu provedor"
                    android:textColor="#8CFFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CÓDIGO"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/edtDns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="#66FFFFFF"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:inputType="text"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USUÁRIO"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/edtUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="#66FFFFFF"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:inputType="text"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SENHA"
                    android:textColor="#00E676"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:textStyle="bold"/>
                <EditText
                    android:id="@+id/edtPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="#66FFFFFF"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:inputType="textPassword"/>

                <Button
                    android:id="@+id/btnLoginCode"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="ENTRAR"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FF000000"
                    android:backgroundTint="#00E676"
                    android:layout_marginTop="24dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===== Rodapé ===== -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/txtDisclaimer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/loginCard"
            android:layout_marginEnd="32dp"/>

        <!-- MAC -->
        <LinearLayout
            android:id="@+id/macBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/txtVersion"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAC"
                android:textColor="#8CFFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.2"/>
            <TextView
                android:id="@+id/txtMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"/>
            <Button
                android:id="@+id/btnCheckMac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verificar ativação"
                android:textSize="13sp"
                android:textColor="#FFFFFFFF"
                android:backgroundTint="#1FFFFFFF"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Painel + Chave (centro) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@id/txtVersion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAINEL"
                android:textColor="#8CFFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.2"/>
            <TextView
                android:id="@+id/txtPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="appasterplay.top"
                android:textColor="#00E676"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHAVE"
                android:textColor="#8CFFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.2"
                android:layout_marginTop="10dp"/>
            <TextView
                android:id="@+id/txtKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#66FFFFFF"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
